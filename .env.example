# ============================================================
# .env.example —— 环境变量样例（复制成 .env 后填自己的值）
# ============================================================
# 【安全铁律】
#   1. 真实的 .env 文件**绝不能提交到 Git**（.gitignore 已排除）。
#   2. 密钥只放这里 / 系统环境变量，绝不写进任何 .py 源码或文档。
#   3. 不要把填好的 .env 发到群里 / 贴到对话里 / 截图。
#
# 【怎么用】
#   - 命令行（临时）：
#       Windows PowerShell:  $env:ALIYUN_ACCESS_KEY_ID="你的值"
#       Git Bash / Linux :   export ALIYUN_ACCESS_KEY_ID="你的值"
#   - 持久化（推荐）：系统「环境变量」里新增，或用 python-dotenv 读取 .env
#
# ============================================================
# 【当前主用】阿里云智能语音交互 —— 说话人分离
# ------------------------------------------------------------
# 去哪拿：
#   1) AccessKey：阿里云控制台右上角头像 → AccessKey 管理 → 创建 AccessKey
#      （建议用 RAM 子账号 + 最小权限，别用主账号 AK）
#   2) AppKey：智能语音交互控制台 → 项目 → 创建项目（选「录音文件识别」）
#      → 项目详情里的 Appkey
#   接口：录音文件识别 OpenAPI，Version=2018-08-17，两阶段异步
#        （SubmitTask 提交 → GetTaskResult 轮询）
#   注意：音频必须是**公网可访问的 URL**（不支持本地文件）。
# ============================================================

# ---- 阿里云（必填 3 项）----

# 访问密钥 ID
ALIYUN_ACCESS_KEY_ID=your_access_key_id_here

# 访问密钥 Secret
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret_here

# 智能语音交互项目 AppKey（录音文件识别必填）
ALIYUN_APP_KEY=your_app_key_here

# ---- 阿里云 可选配置 ----

# 区域（默认 cn-shanghai）。可选：cn-shanghai / cn-beijing / cn-shenzhen 等
ALIYUN_REGION_ID=cn-shanghai

# 录音文件识别接入点（默认按 region 推导为 filetrans.<region>.aliyuncs.com，一般不用填）
ALIYUN_FILE_TRANS_HOST=

# 期望说话人上限（1~10）。留空 = 服务端自动判断人数（推荐）。
# 官方说明：10 人以内效果较好。
ALIYUN_SPEAKER_MAX=

# ============================================================
# 【保留，暂停使用，勿删】火山引擎豆包 说话人分离
# ------------------------------------------------------------
# 去哪拿：火山引擎控制台 → 语音技术 → 创建应用并开通
#         「录音文件识别（大模型版）」→ 应用详情里能看到 App ID / Access Token。
# ============================================================

# 控制台 App ID（请求头 X-Api-App-Key）
VOLC_APP_ID=your_app_id_here

# 控制台 Access Token（请求头 X-Api-Access-Key）
VOLC_ACCESS_TOKEN=your_access_token_here

# 业务集群 Cluster ID（请求头 X-Api-Cluster）
# 说明：录音文件识别（HTTP 异步）接口不强制要求；流式接口必填。
VOLC_CLUSTER_ID=

# 资源 ID：豆包录音文件识别模型 2.0 = volc.seedasr.auc（默认，推荐）
VOLC_RESOURCE_ID=volc.seedasr.auc

# 期望说话人上限（1~10）。留空 = 自动判断人数。
VOLC_SPEAKER_MAX=

# ---- 项目其它钥匙（与本模块无关，列在此处便于集中管理）----

# DeepSeek 高光分析用的 Key（项目原有，别删）
DEEPSEEK_API_KEY=
