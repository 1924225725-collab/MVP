# Python 运行产物
__pycache__/
*.pyc

# 虚拟环境（体积大，每台电脑自己装）
.venv/

# 媒体文件与生成结果（体积大/含个人数据，不上传）
videos/*
audio/*
transcripts/*
highlights.json

# v0.3 运行产物：分析结果与自测报告（本地生成，每次跑都不一样）
highlights_v2.json
phase1_report.txt
phase2_report.txt
v031_report.txt
v032_report.txt

# API 钥匙文件（网页版保存的 DeepSeek Key，绝不能上传）
api_key.txt

# 但保留文件夹本身（否则 git 不追踪空文件夹）
!videos/.gitkeep
!audio/.gitkeep
!transcripts/.gitkeep

# 系统杂项
Thumbs.db
.DS_Store
